# AEGISFLOW ENTERPRISE CONFIGURATION
PORT=5000
NODE_ENV=development

# Google Gemini AI SDK (@google/genai)
# Provide your Gemini API key to enable live gemini-2.5-flash agentic inference.
# If left blank, AegisFlow uses its high-fidelity deterministic autonomous decision engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Cloud PostgreSQL & Auth
# Option 1: Direct PostgreSQL Connection String (for running migrations & DDL via `npm run db:migrate`)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Option 2: Supabase API Keys (Found in: Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
